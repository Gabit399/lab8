    {
      "name": "4. ⭐ Transcript (all 3 databases)",
      "description": "The main cross-database endpoint. Open the **Visualize** tab.",
      "item": [
        {
          "name": "Get transcript",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students/{{studentId}}/transcript",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students",
                "{{studentId}}",
                "transcript"
              ]
            },
            "description": "1) student from **student_db** → 2) grades from **grade_db** → 3) courses from **course_db** (one `findAllById` query) → joined in GradeService and averaged."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const t = pm.response.json();",
                  "pm.test(\"Transcript combines all three databases\", () => {",
                  "    pm.expect(t.studentName, \"student_db\").to.be.a(\"string\");",
                  "    pm.expect(t.courses, \"grade_db\").to.have.lengthOf(2);",
                  "    pm.expect(t.courses[0].courseName, \"course_db\").to.be.a(\"string\");",
                  "});",
                  "pm.test(\"Average score and letter are calculated\", () => {",
                  "    pm.expect(t.averageScore).to.eql(88.5);   // (92 + 85) / 2",
                  "    pm.expect(t.averageLetterGrade).to.eql(\"B\");",
                  "    pm.expect(t.totalCredits).to.eql(9);      // 5 + 4",
                  "});",
                  "pm.visualizer.set(`",
                  "<style>",
                  "  body{font-family:-apple-system,Segoe UI,sans-serif;padding:16px;color:#1f2937}",
                  "  .card{border:1px solid #e5e7eb;border-radius:10px;padding:16px 20px;max-width:760px}",
                  "  h2{margin:0 0 4px}",
                  "  .muted{color:#6b7280;font-size:13px}",
                  "  table{border-collapse:collapse;width:100%;margin:14px 0;font-size:14px}",
                  "  th,td{border-bottom:1px solid #e5e7eb;padding:8px;text-align:left}",
                  "  th{background:#f9fafb}",
                  "  .badge{display:inline-block;min-width:22px;text-align:center;padding:2px 8px;border-radius:12px;color:#fff;font-weight:700}",
                  "  .A{background:#16a34a}.B{background:#2563eb}.C{background:#ca8a04}.D{background:#ea580c}.F{background:#dc2626}",
                  "  .sum{display:flex;gap:28px;font-size:15px}",
                  "  .src{margin-top:14px;font-size:12px;color:#6b7280}",
                  "  .db{display:inline-block;padding:1px 6px;border-radius:4px;background:#eef2ff;color:#3730a3;margin-right:4px}",
                  "</style>",
                  "<div class=\"card\">",
                  "  <h2>🎓 {{studentName}}</h2>",
                  "  <div class=\"muted\">ID {{studentId}} · {{email}} · {{major}} · enrolled {{enrollmentYear}}</div>",
                  "  <table>",
                  "    <tr><th>Code</th><th>Course</th><th>Instructor</th><th>Credits</th><th>Score</th><th>Grade</th></tr>",
                  "    {{#each courses}}",
                  "    <tr><td>{{courseCode}}</td><td>{{courseName}}</td><td>{{instructor}}</td>",
                  "        <td>{{credits}}</td><td>{{score}}</td><td><span class=\"badge {{letterGrade}}\">{{letterGrade}}</span></td></tr>",
                  "    {{/each}}",
                  "  </table>",
                  "  <div class=\"sum\">",
                  "    <div>Total credits: <b>{{totalCredits}}</b></div>",
                  "    <div>Average score: <b>{{averageScore}}</b></div>",
                  "    <div>Average grade: <span class=\"badge {{averageLetterGrade}}\">{{averageLetterGrade}}</span></div>",
                  "  </div>",
                  "  <div class=\"src\">Data sources:",
                  "    <span class=\"db\">student_db</span> name, email, major ·",
                  "    <span class=\"db\">grade_db</span> scores ·",
                  "    <span class=\"db\">course_db</span> course names, credits</div>",
                  "</div>`, t);"
                ]
              }
            }
          ]
        }
      ]
    },
