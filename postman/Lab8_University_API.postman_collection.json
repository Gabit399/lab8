{
  "info": {
    "name": "Lab 8 - University Management System (3 databases)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Demo collection for Lab 8. One Spring Boot app, three PostgreSQL databases (student_db, course_db, grade_db).\n\n**How to demo:** run the folders 0 → 6 top to bottom (or the whole collection in the Runner). Every run uses a new suffix `{{run}}`, so emails and course codes never clash and the demo can be repeated. Created ids are saved automatically. Open the **Visualize** tab to see tables, the transcript card and error cards."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// A unique suffix keeps emails and course codes unique, so the demo can be run again and again.",
          "if (!pm.collectionVariables.get(\"run\")) {",
          "    pm.collectionVariables.set(\"run\", String(Date.now()).slice(-6));",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const ct = pm.response.headers.get(\"Content-Type\") || \"\";",
          "if (ct.includes(\"json\") && pm.response.text()) {",
          "    const data = pm.response.json();",
          "    const style = `<style>",
          "      body{font-family:-apple-system,Segoe UI,sans-serif;padding:12px;color:#1f2937}",
          "      table{border-collapse:collapse;width:100%;font-size:13px}",
          "      th,td{border:1px solid #e5e7eb;padding:6px 8px;text-align:left}",
          "      th{background:#f3f4f6}",
          "      .err{border-left:6px solid #dc2626;background:#fef2f2;padding:12px 16px;border-radius:6px}",
          "      .code{font-size:28px;font-weight:700;color:#dc2626}",
          "    </style>`;",
          "    if (pm.response.code >= 400 && data.status) {",
          "        pm.visualizer.set(style + `",
          "          <div class=\"err\">",
          "            <div class=\"code\">{{status}} {{error}}</div>",
          "            <p><b>message:</b> {{message}}</p>",
          "            <p><b>path:</b> {{path}}</p>",
          "            {{#if fieldErrors}}<table><tr><th>field</th><th>error</th></tr>",
          "              {{#each fieldErrors}}<tr><td>{{@key}}</td><td>{{this}}</td></tr>{{/each}}",
          "            </table>{{/if}}",
          "          </div>`, data);",
          "    } else if (Array.isArray(data) && data.length) {",
          "        const cols = Object.keys(data[0]);",
          "        pm.visualizer.set(style + `",
          "          <p><b>{{rows.length}} rows</b></p>",
          "          <table><tr>{{#each cols}}<th>{{this}}</th>{{/each}}</tr>",
          "          {{#each rows}}<tr>{{#each this}}<td>{{this}}</td>{{/each}}</tr>{{/each}}</table>`,",
          "          { cols, rows: data.map(r => cols.map(c => r[c])) });",
          "    }",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "run",
      "value": ""
    },
    {
      "key": "studentId",
      "value": ""
    },
    {
      "key": "courseId",
      "value": ""
    },
    {
      "key": "courseId2",
      "value": ""
    },
    {
      "key": "gradeId",
      "value": ""
    },
    {
      "key": "gradeId2",
      "value": ""
    }
  ],
