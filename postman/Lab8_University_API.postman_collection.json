    {
      "name": "0. Start",
      "description": "Run this first. It checks that the app is up and creates a new unique suffix {{run}}.",
      "item": [
        {
          "name": "Start demo (health check)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students"
              ]
            },
            "description": "App is running and connected to student_db. Open the **Visualize** tab to see the table."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"run\", String(Date.now()).slice(-6));",
                  "console.log(\"Demo run suffix:\", pm.collectionVariables.get(\"run\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns a JSON array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        }
      ]
    },
